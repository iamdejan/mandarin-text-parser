{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "deps": "pnpm install",
    "deps:update": "pnpm install && pnpm update --latest",
    "type:check": "tsc -b",
    "build": "tsc -b && vite build",
    "serve": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ci": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "opencc-js": "^1.4.2",
    "solid-js": "^1.9.18",
    "solidjs-use": "^2.3.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-solid": "^0.19.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  }
}
